# Claves de Stripe (modo test para desarrollo local)
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=<tu_clave_secreta_de_stripe_test>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<tu_clave_publica_de_stripe_test>

# Se obtiene al ejecutar `stripe listen` (ver README) o desde el
# dashboard de Stripe al crear un endpoint de webhook.
STRIPE_WEBHOOK_SECRET=<tu_webhook_secret_de_stripe>

# URL pública del sitio, usada para construir success_url y cancel_url.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
